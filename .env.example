# Shared environment defaults for Docker Compose
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_DB=college_erp_db
DATABASE_URL=postgresql://erp_user:change-me-before-production@postgres:5432/college_erp_db?schema=public
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
VITE_API_URL=/api/v1