{
  "name": "college-erp-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Multi-Tenant College ERP SaaS Platform",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:backend": "npm --workspace=backend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm --workspace=frontend run build",
    "build:backend": "npm --workspace=backend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "docker:up": "docker-compose up --build -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.0",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "concurrently": "^8.2.2",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  }
}
